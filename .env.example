# This file documents every environment variable used across the platform.
# Each service loads its own .env from its own directory at runtime:
#   backend/.env   <- copy from backend/.env.example
#   frontend/.env  <- copy from frontend/.env.example
# This root file is a reference only.

# ---- backend/.env ----
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=cue_platform
DB_SYNCHRONIZE=false
DB_LOGGING=false

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---- frontend/.env ----
VITE_API_BASE_URL=http://localhost:4000

# Demo mode (see frontend/.env.demo) replaces every API call with in-memory
# mock data — no backend, no database, no Claude API calls. Used for the
# portfolio demo build (`npm run build:demo` inside frontend/).
VITE_DEMO_MODE=false
