# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=cue_platform
# Set to true only for local scratch databases. Never enable against a real
# database - it lets TypeORM auto-alter tables and bypasses migrations.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# File uploads (LOB documents)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
